# Copia este archivo a `.env` y rellena los valores

# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=pon_aqui_tu_token

# Canal donde el bot avisa al admin y muestra los botones Aprobar/Rechazar
ADMIN_CHANNEL_ID=

# Canal de verificación donde SOLO ahí funciona /team (ID del canal)
VERIFY_CHANNEL_ID=

# (Opcional) ID del servidor para que /team aparezca al instante
GUILD_ID=

# (Opcional) ID del rol que se asigna automáticamente al aprobar
ROLE_ID=

# (Opcional) Secreto para que solo tu bot pueda enviar solicitudes por API
API_SECRET=

# Puerto del servidor (Render lo asigna solo)
PORT=3000
