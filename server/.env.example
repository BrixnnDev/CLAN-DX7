# Copia este archivo a `.env` y rellena los valores

# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=pon_aqui_tu_token

# Canal donde el bot avisa al admin y muestra los botones Aprobar/Rechazar
ADMIN_CHANNEL_ID=

# Canal de verificación donde SOLO ahí funciona /team (ID del canal)
VERIFY_CHANNEL_ID=

# (Opcional) ID del servidor para que /team aparezca al instante
GUILD_ID=

# (Opcional) ID del rol de Verificado que se asigna SIEMPRE al aprobar
VERIFY_ROLE_ID=

# (Opcional) ID del rol de Miembro que se asigna SIEMPRE al aprobar
MEMBER_ROLE_ID=

# (Opcional) IDs de los roles que se asignan al aprobar. Varios separados por coma: 111,222,333
ROLE_ID=

# (Opcional) Secreto para que solo tu bot pueda enviar solicitudes por API
API_SECRET=

# API de Free Fire para obtener datos del jugador por ID
# Obtén tu key gratis en https://developers.freefirecommunity.com (plan Beginner)
FF_API_KEY=
# (Opcional) URL de la API (cambia solo si usas otro proveedor)
FF_API_URL=https://developers.freefirecommunity.com/api/v1/info
# (Opcional) Regiones a probar en orden, separadas por coma
FF_REGIONS=br,latam,us,ind,id,pk,vn,sg

# Puerto del servidor (Render lo asigna solo)
PORT=3000
